@using Project_Managent_System.Models
@model Tuple<List<Project>, List<Task>>

@{
    ViewBag.Title = "Admin Dashboard";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

<div class="container-fluid py-4 px-4 bg-light min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate-900 m-0">Executive Dashboard</h2>
            <p class="text-muted small">Comprehensive system analytics and resource tracking</p>
        </div>
        <button class="btn btn-indigo shadow-sm rounded-3 px-4" onclick="window.print()">
            <i class="bi bi-download me-2"></i>Export Report
        </button>
    </div>

    @* --- STAT CARDS --- *@
    <div class="row g-4 mb-4">
        @foreach (var stat in new[] {
            new { Label = "Admins", Count = ViewBag.AdminCount, Color = "primary", Icon = "shield-lock" },
            new { Label = "Managers", Count = ViewBag.ManagerCount, Color = "warning", Icon = "person-badge" },
            new { Label = "Employees", Count = ViewBag.EmployeeCount, Color = "success", Icon = "people" }
        })
        {
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                    <div class="card-body p-4 border-start border-@stat.Color border-5">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6 class="text-muted small text-uppercase fw-bold mb-1">@stat.Label</h6>
                                <h2 class="fw-black mb-0">@stat.Count</h2>
                            </div>
                            <div class="bg-@stat.Color-subtle p-3 rounded-4">
                                <i class="bi bi-@stat.Icon text-@stat.Color fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* --- CHARTS ROW --- *@
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="fw-bold m-0">Project Status Distribution</h6>
                </div>
                <div class="card-body p-4">
                    <canvas id="projectBarChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="fw-bold m-0">Task Priority Breakdown</h6>
                </div>
                <div class="card-body p-4 d-flex align-items-center justify-content-center">
                    <canvas id="taskPieChart" style="max-height: 250px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    @* --- ENHANCED GANTT CHART WITH MONTH FILTER --- *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold m-0"><i class="bi bi-calendar-range me-2 text-indigo"></i>Project Timeline</h6>
            <div class="btn-group btn-group-sm" id="ganttMonthFilter">
                <button type="button" class="btn btn-outline-indigo active" data-month="all">All</button>
                <button type="button" class="btn btn-outline-indigo" data-month="0">Jan</button>
                <button type="button" class="btn btn-outline-indigo" data-month="1">Feb</button>
                <button type="button" class="btn btn-outline-indigo" data-month="2">Mar</button>
                <button type="button" class="btn btn-outline-indigo" data-month="3">Apr</button>
                <button type="button" class="btn btn-outline-indigo" data-month="4">May</button>
            </div>
        </div>
        <div class="card-body p-4">
            <div id="chart_div" style="min-height: 300px; width: 100%;"></div>
        </div>
    </div>

    @* --- PERFORMANCE TABLE --- *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold m-0">Project Performance</h6>
            <input type="text" id="prjSearch" class="form-control form-control-sm rounded-pill border-0 bg-light px-3" style="width: 200px;" placeholder="Search projects...">
        </div>
        <div class="table-responsive p-3">
            <table id="projectTable" class="table table-hover align-middle mb-0">
                <thead class="bg-light fs-xs text-uppercase text-muted">
                    <tr>
                        <th class="ps-4">Project</th>
                        <th>Status</th>
                        <th>Workload</th>
                        <th class="pe-4">Health/Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Item1 != null)
                    {
                        foreach (var p in Model.Item1)
                        {
                            var totalTasks = p.Tasks.Count;
                            var completedTasks = p.Tasks.Count(t => t.Status == "Completed");
                            var percent = totalTasks > 0 ? (completedTasks * 100) / totalTasks : 0;

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@p.ProjectName</div>
                                    <small class="text-muted">By: @(p.Project_Members ?? "Admin")</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3">@p.Status</span>
                                </td>
                                <td>@totalTasks Tasks</td>
                                <td class="pe-4" style="width: 200px;">
                                    <div class="progress rounded-pill mb-1" style="height: 8px;">
                                        <div class="progress-bar bg-indigo" style="width: @percent%"></div>
                                    </div>
                                    <small class="text-muted d-block text-end">@percent% Complete</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    :root {
        --indigo: #4F46E5;
        --indigo-soft: #eef2ff;
        --slate-900: #0f172a;
    }

    body {
        background-color: #f8fafc;
        font-family: 'Inter', sans-serif;
    }

    .fw-black {
        font-weight: 900;
    }

    .fs-xs {
        font-size: 0.7rem;
    }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .bg-indigo {
        background-color: var(--indigo);
    }

    .btn-indigo {
        background: var(--indigo);
        color: white;
        border: none;
    }

    .btn-outline-indigo {
        color: var(--indigo);
        border-color: var(--indigo);
    }

        .btn-outline-indigo.active, .btn-outline-indigo:hover {
            background: var(--indigo);
            color: white;
        }

    .bg-primary-subtle {
        background-color: #eef2ff;
        color: #4F46E5;
    }

    .bg-warning-subtle {
        background-color: #fffbeb;
        color: #b45309;
    }

    .bg-success-subtle {
        background-color: #f0fdf4;
        color: #15803d;
    }

    .dataTables_filter {
        display: none;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

    <script>
    // 1. Data Object for Gantt Chart (Loaded from Model)
    var allGanttData = [
        @if (Model?.Item1 != null) {
            foreach (var p in Model.Item1) {
                var total = p.Tasks.Count;
                var comp = p.Tasks.Count(t => t.Status == "Completed");
                var pct = total > 0 ? (comp * 100) / total : 0;
                <text>
                {
                    id: '@p.ProjectId',
                    name: '@p.ProjectName',
                    team: '@(p.Project_Members ?? "Team")',
                    start: new Date(@p.StartDate.Year, @(p.StartDate.Month - 1), @p.StartDate.Day),
                    end: new Date(@p.EndDate.Year, @(p.EndDate.Month - 1), @p.EndDate.Day),
                    percent: @pct,
                    startMonth: @(p.StartDate.Month - 1)
                },
                </text>
            }
        }
    ];

    $(document).ready(function () {
        // --- Chart.js: Bar Chart ---
        const ctxBar = document.getElementById('projectBarChart').getContext('2d');
        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: ['Active', 'Completed', 'On Hold', 'Archived'],
                datasets: [{
                    label: 'Projects',
                    data: [12, 19, 13, 5],
                    backgroundColor: '#4F46E5',
                    borderRadius: 10
                }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });

        // --- Chart.js: Pie Chart ---
        const ctxPie = document.getElementById('taskPieChart').getContext('2d');
        new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: ['High', 'Medium', 'Low'],
                datasets: [{
                    data: [30, 50, 20],
                    backgroundColor: ['#ef4444', '#f59e0b', '#10b981'],
                    borderWidth: 0,
                    cutout: '70%'
                }]
            }
        });

        // --- DataTables ---
        var pTable = $('#projectTable').DataTable({ "dom": 'rt<"bottom"p>', "pageLength": 5 });
        $('#prjSearch').on('keyup', function () { pTable.search(this.value).draw(); });

        // --- Google Gantt Chart Initialization ---
        google.charts.load('current', { 'packages': ['gantt'] });
        google.charts.setOnLoadCallback(() => drawGanttChart('all'));

        // Filter Event
        $('#ganttMonthFilter button').on('click', function() {
            $('#ganttMonthFilter button').removeClass('active');
            $(this).addClass('active');
            drawGanttChart($(this).data('month'));
        });
    });

    function drawGanttChart(filter) {
        var container = document.getElementById('chart_div');
        var dataTable = new google.visualization.DataTable();
        dataTable.addColumn('string', 'Task ID');
        dataTable.addColumn('string', 'Task Name');
        dataTable.addColumn('string', 'Resource');
        dataTable.addColumn('date', 'Start Date');
        dataTable.addColumn('date', 'End Date');
        dataTable.addColumn('number', 'Duration');
        dataTable.addColumn('number', 'Percent Complete');
        dataTable.addColumn('string', 'Dependencies');

        var rows = [];
        allGanttData.forEach(function(item) {
            if (filter === 'all' || item.startMonth == filter) {
                rows.push([item.id, item.name, item.team, item.start, item.end, null, item.percent, null]);
            }
        });

        if(rows.length === 0) {
            container.innerHTML = '<div class="p-5 text-center text-muted">No projects found for this month.</div>';
            return;
        }

        dataTable.addRows(rows);

        var options = {
            height: rows.length * 45 + 50,
            gantt: {
                trackHeight: 40,
                barHeight: 25,
                labelStyle: { fontName: 'Inter', fontSize: 13 },
                palette: [{ "color": "#4F46E5", "dark": "#3730a3", "light": "#eef2ff" }]
            }
        };

        var chart = new google.visualization.Gantt(container);
        chart.draw(dataTable, options);
    }
    </script>
}