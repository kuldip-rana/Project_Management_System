@model IEnumerable<Project_Managent_System.Models.Task>

@{
    ViewBag.Title = "Manage Tasks";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate-900 m-0">Task Repository</h2>
            <p class="text-muted small">Overview of all project tasks and performance tracking</p>
        </div>
        @*<div>
            <a href="@Url.Action("Create", "Tasks")" class="btn btn-indigo px-4 py-2 rounded-3 shadow-sm">
                <i class="bi bi-plus-lg me-2"></i> Create New Task
            </a>
        </div>*@
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase fs-xs fw-bold text-muted">Task Details</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-muted text-center">Project & Owner</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-muted">Priority</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-muted">Timeline</th>
                        <th class="pe-4 py-3 text-center text-uppercase fs-xs fw-bold text-muted">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var collapseId = "taskDesc_" + item.TaskId;

                        <tr class="task-main-row">
                            <td class="ps-4">
                                <div class="fw-bold text-slate-900">@item.TaskTitle</div>
                                @*<div class="text-muted fs-xs text-truncate" style="max-width: 250px;">@item.TaskDescription</div>*@
                            </td>
                            <td class="text-center">
                                <div class="fw-medium text-indigo small">@item.Project.ProjectName</div>
                                <div class="text-muted x-small">By: @item.Main_Users.FirstName</div>
                            </td>
                            <td>
                                <span class="badge @(item.Priority == "High" ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") rounded-pill px-3">
                                    @item.Priority
                                </span>
                            </td>
                            <td>
                                <div class="small fw-medium text-slate-700">Due: @item.DueDate.ToString("MMM dd, yyyy")</div>
                                <div class="text-muted x-small">Started: @item.StartDate.ToString("MMM dd")</div>
                            </td>
                            <td class="pe-4 text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <button class="btn btn-sm btn-light-primary rounded-circle" onclick="openComments(@item.TaskId, 'Task')" title="Open Task Discussion">
                                        <i class="bi bi-chat-dots-fill"></i>
                                    </button>
                                    <a href="@Url.Action("Edit", "Tasks", new { id = item.TaskId })" class="btn btn-sm btn-light-indigo rounded-circle" title="Edit">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    @* Toggle Button *@
                                    <button class="btn btn-sm btn-light-secondary rounded-circle btn-expand"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId"
                                            aria-expanded="false">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                    <a href="@Url.Action("Delete", "Tasks", new { id = item.TaskId })" class="btn btn-sm btn-light-danger rounded-circle" title="Delete" onclick="return confirm('Permanently delete this task?')">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>

                        <tr class="description-row">
                            <td colspan="5" class="p-0 border-0">
                                <div id="@collapseId" class="collapse accordion-collapse">
                                    <div class="description-body p-4 mx-4 mb-3 rounded-bottom-4 shadow-inner">
                                        <h6 class="fw-bold text-indigo small mb-2">
                                            <i class="bi bi-text-paragraph me-2"></i>Full Description
                                        </h6>
                                        <div class="description-text">
                                            @item.TaskDescription
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    :root {
        --indigo: #4F46E5;
        --indigo-soft: #eef2ff;
        --slate-900: #0f172a;
    }

    .fs-xs {
        font-size: 0.75rem;
    }

    .x-small {
        font-size: 0.65rem;
    }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .rounded-bottom-4 {
        border-bottom-left-radius: 1rem;
        border-bottom-right-radius: 1rem;
    }

    .btn-indigo {
        background: var(--indigo);
        color: white;
        border: none;
    }

        .btn-indigo:hover {
            background: #4338ca;
            color: white;
        }

    .bg-primary-subtle {
        background-color: #e0e7ff;
        color: #4338ca;
    }

    .bg-danger-subtle {
        background-color: #fee2e2;
        color: #b91c1c;
    }

    .btn-light-indigo {
        background: var(--indigo-soft);
        color: var(--indigo);
        border: none;
    }

    .btn-light-primary {
        background: #e0e7ff;
        color: #4338ca;
        border: none;
    }

    .btn-light-danger {
        background: #fee2e2;
        color: #ef4444;
        border: none;
    }

    .btn-light-secondary {
        background: #f1f5f9;
        color: #64748b;
        border: none;
    }

    /* 1. Prevent Column Shifting */
    .table {
        table-layout: fixed;
        width: 100% !important;
    }

    /* 2. Smooth Slide Animation Logic */
    .collapse {
        transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .description-body {
        background-color: #f8fafc; /* Very light slate */
        border-left: 4px solid var(--indigo);
        border-bottom: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
    }

    /* 3. Text Handling to prevent width expansion */
    .description-text {
        font-size: 0.875rem;
        color: #475569;
        line-height: 1.6;
        white-space: pre-wrap;
        word-wrap: break-word; /* Crucial for long strings/links */
        overflow-wrap: break-word;
    }

    /* 4. Action Button Styling when active */
    .btn-expand[aria-expanded="true"] {
        background-color: var(--indigo) !important;
        color: white !important;
        transform: scale(1.1);
        transition: all 0.2s ease;
    }

    /* 5. Clean up table hover */
    .description-row:hover {
        background-color: transparent !important;
    }

    /* Custom styles for expansion */
    .task-main-row:hover {
        background-color: rgba(79, 70, 229, 0.02);
    }

    .btn-expand[aria-expanded="true"] {
        background-color: var(--indigo) !important;
        color: white !important;
    }

    .shadow-inner {
        box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.05);
    }

    .border-indigo {
        border-color: var(--indigo) !important;
    }

    /* Transition fix for smooth expansion */
    .collapse {
        transition: all 0.35s ease-in-out;
    }
</style>