@model Project_Managent_System.Models.Task

@{
    ViewBag.Title = "Create Task";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = DateTime.Now.ToString("yyyy-MM-dd");
}

<style>
    /* --- THEME VARIABLES --- */
    :root {
        --primary: #6366F1;
        --text-dark: #1F2937;
        --text-muted: #6B7280;
        --border-color: #E5E7EB;
        --bg-light: #F9FAFB;
    }

    /* --- CARD STYLING --- */
    .form-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 10px 15px -3px rgba(0, 0, 0, 0.03);
        background: #fff;
    }

    /* --- INPUTS & LABELS --- */
    .form-label {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .form-control, .form-select {
        border-color: var(--border-color);
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        font-size: 0.95rem;
        transition: all 0.2s;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

    /* Input Group Icons */
    .input-group-text {
        background-color: var(--bg-light);
        border-color: var(--border-color);
        color: var(--text-muted);
    }

    /* Readonly styling */
    .form-control[readonly] {
        background-color: #F3F4F6;
        color: #6B7280;
        cursor: not-allowed;
    }

    /* CKEditor Customization to match theme */
    .ck-editor__editable_inline {
        min-height: 180px;
        border-bottom-left-radius: 0.5rem !important;
        border-bottom-right-radius: 0.5rem !important;
    }

    .ck-toolbar {
        border-top-left-radius: 0.5rem !important;
        border-top-right-radius: 0.5rem !important;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card form-card">
                <div class="card-body p-4 p-md-5">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h3 class="fw-bold mb-1" style="color: var(--text-dark);">Create New Task</h3>
                            <p class="text-muted small mb-0">Define task details and assign parameters.</p>
                        </div>
                        <div class="bg-light rounded-circle p-3 text-primary">
                            <i class="bi bi-clipboard-plus fs-4"></i>
                        </div>
                    </div>

                    @using (Html.BeginForm("CreateTask", "Tasks", FormMethod.Post, new { novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger mb-4" })

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Target Project</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-folder"></i></span>
                                    @Html.DropDownList("ProjectId", ViewBag.ProjectId as SelectList, "-- Select Project --", new { @class = "form-select", required = "required" })
                                </div>
                                @Html.ValidationMessageFor(m => m.ProjectId, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Task Owner (You)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person-lock"></i></span>
                                    <input type="text" class="form-control" value="@Session["Name"]" readonly />
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.TaskTitle, "Task Title", new { @class = "form-label" })
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-type-h1"></i></span>
                                @Html.TextBoxFor(m => m.TaskTitle, new { @class = "form-control", placeholder = "e.g. Design Homepage Wireframes", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.TaskTitle, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Priority, new { @class = "form-label" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-flag"></i></span>
                                    @Html.DropDownListFor(m => m.Priority, new SelectList(new[] { "Low", "Medium", "High" }), "-- Select Priority --", new { @class = "form-select", required = "required" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Priority, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Status, new { @class = "form-label" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-activity"></i></span>
                                    @Html.DropDownListFor(m => m.Status, new SelectList(new[] { "Pending", "In Progress", "Completed" }), "-- Select Status --", new { @class = "form-select", required = "required" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger small mt-1" })
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.StartDate, "Start Date", new { @class = "form-label" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                    @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", min = today, id = "startDate" })
                                </div>
                                @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger small mt-1" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.DueDate, "Due Date", new { @class = "form-label" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-calendar-check"></i></span>
                                    @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "endDate" })
                                </div>
                                @Html.ValidationMessageFor(m => m.DueDate, "", new { @class = "text-danger small mt-1" })
                            </div>
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.TaskDescription, "Description & Requirements", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.TaskDescription, new { @class = "form-control", id = "editor", rows = 5 })
                            @Html.ValidationMessageFor(m => m.TaskDescription, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <hr class="my-4 text-muted opacity-25">

                        <div class="d-flex justify-content-end gap-2">
                            <a href="@Url.Action("ManagerDashboard", "Manager")" class="btn btn-light text-muted fw-semibold px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm" style="background-color: var(--primary); border: none;">
                                Create Task
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'), {
                toolbar: ['heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', 'blockQuote'],
                placeholder: 'Detailed description of the task...'
            })
            .catch(error => console.error(error));
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const startDate = document.getElementById("startDate");
            const endDate = document.getElementById("endDate");

            // On change of start date
            startDate.addEventListener("change", function () {
                endDate.min = this.value; // Prevent selecting due date before start date

                // If existing end date is invalid, clear it
                if (endDate.value && endDate.value < this.value) {
                    endDate.value = "";
                }
            });

            // Initial Check (if editing or pre-filled)
            if (startDate.value) {
                endDate.min = startDate.value;
            }
        });
    </script>
}