@model Project_Managent_System.ViewModels.TaskReAssignViewModel

@{
    ViewBag.Title = "Re-Assign Task";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* --- THEME VARIABLES --- */
    :root {
        --primary: #6366F1;
        --text-dark: #1F2937;
        --text-muted: #6B7280;
        --border-color: #E5E7EB;
        --bg-light: #F9FAFB;
    }

    /* --- CARD STYLING --- */
    .reassign-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 10px 15px -3px rgba(0, 0, 0, 0.03);
        background: #fff;
    }

    /* --- SELECT STYLING --- */
    .form-select-lg {
        padding: 0.75rem 1rem;
        font-size: 1rem;
        border-radius: 8px;
        border-color: var(--border-color);
    }

        .form-select-lg:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

    /* --- USER SELECTION LIST --- */
    .user-list-container {
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        background-color: #fff;
    }

    .user-search-header {
        padding: 1rem;
        border-bottom: 1px solid var(--border-color);
        background-color: var(--bg-light);
    }

    .user-scroll-box {
        max-height: 300px;
        overflow-y: auto;
        padding: 0.5rem;
    }

    /* Custom Checkbox Card */
    .user-option-card {
        display: flex;
        align-items: center;
        padding: 10px 12px;
        margin-bottom: 4px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid transparent;
        position: relative;
    }

        .user-option-card:hover {
            background-color: #F3F4F6;
        }

    /* When Checked */
    .user-check-input:checked + .user-option-card {
        background-color: #EEF2FF;
        border-color: #C7D2FE;
    }

        .user-check-input:checked + .user-option-card .user-name {
            color: var(--primary);
            font-weight: 600;
        }

    .user-check-input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
        height: 0;
        width: 0;
    }

    /* Avatar & Checkmark */
    .user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #E5E7EB;
        color: #4B5563;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        margin-right: 12px;
        transition: 0.2s;
    }

    .user-check-input:checked + .user-option-card .user-avatar {
        background-color: var(--primary);
        color: #fff;
    }

    .check-indicator {
        margin-left: auto;
        color: var(--primary);
        opacity: 0;
        transform: scale(0.5);
        transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .user-check-input:checked + .user-option-card .check-indicator {
        opacity: 1;
        transform: scale(1);
    }

    /* --- STEP INDICATOR --- */
    .step-circle {
        width: 28px;
        height: 28px;
        background-color: var(--primary);
        color: white;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: bold;
        margin-right: 8px;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1" style="color: var(--text-dark);">Re-Assign Task</h3>
                    <p class="text-muted small mb-0">Modify team members for existing tasks.</p>
                </div>
                <a href="@Url.Action("ManagerDashboard", "Manager")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Dashboard
                </a>
            </div>

            <div class="card reassign-card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="step-circle">1</span>
                        <h6 class="fw-bold mb-0 text-uppercase text-muted" style="font-size: 0.85rem; letter-spacing: 0.5px;">Select Task</h6>
                    </div>

                    @using (Html.BeginForm("ReAssignTask", "Tasks", FormMethod.Get))
                    {
                        <div class="d-flex gap-2">
                            <div class="flex-grow-1">
                                @Html.DropDownList("taskId", Model.Tasks, "-- Select a Task to Modify --", new { @class = "form-select form-select-lg", onchange = "this.form.submit()" })
                            </div>
                            <button type="submit" class="btn btn-primary px-4 rounded-3 shadow-sm d-none d-md-block" style="background-color: var(--primary); border:none;">
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                        <div class="form-text mt-2 ms-1">Selecting a task will load current assignees below.</div>
                    }
                </div>
            </div>

            @if (Model.TaskId > 0)
            {
                <div class="card reassign-card animate__animated animate__fadeInUp">
                    <div class="card-body p-4">

                        <div class="alert alert-light border d-flex align-items-center mb-4">
                            <i class="bi bi-info-circle-fill text-primary me-3 fs-4"></i>
                            <div>
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Currently Editing</small>
                                <div class="fw-bold text-dark fs-5">@Model.TaskTitle</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-3">
                            <span class="step-circle">2</span>
                            <h6 class="fw-bold mb-0 text-uppercase text-muted" style="font-size: 0.85rem; letter-spacing: 0.5px;">Update Team Members</h6>
                        </div>

                        @using (Html.BeginForm("ReAssignTask", "Tasks", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.TaskId)

                            <div class="user-list-container mb-4">
                                <div class="user-search-header">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                        <input type="text" id="userSearch" class="form-control border-start-0" placeholder="Search employees..." />
                                    </div>
                                </div>

                                <div class="user-scroll-box">
                                    @foreach (var user in Model.Users)
                                    {
                                        var initial = !string.IsNullOrEmpty(user.Text) ? user.Text.Substring(0, 1).ToUpper() : "U";

                                        <input type="checkbox" name="SelectedUserIds" value="@user.Value" id="user_@user.Value" class="user-check-input" @(user.Selected ? "checked" : "") />

                                        <label class="user-option-card" for="user_@user.Value">
                                            <div class="user-avatar">@initial</div>
                                            <span class="user-name text-dark">@user.Text</span>
                                            <i class="bi bi-check-circle-fill check-indicator fs-5"></i>
                                        </label>
                                    }

                                    <div id="noUsersMsg" class="text-center py-4 text-muted" style="display:none;">
                                        No users match your search.
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 pt-2">
                                <a href="@Url.Action("ReAssignTask")" class="btn btn-light text-muted fw-bold">Cancel</a>
                                <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                                    <i class="bi bi-check-lg me-1"></i> Save Changes
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5 opacity-50">
                    <i class="bi bi-people-fill display-1 text-muted"></i>
                    <p class="mt-3 fw-medium">Select a task above to manage assignments</p>
                </div>
            }

        </div>
    </div>
</div>

<script>
    // Simple User Filter Script
    document.getElementById('userSearch')?.addEventListener('keyup', function() {
        const filter = this.value.toLowerCase();
        const items = document.querySelectorAll('.user-option-card');
        let visibleCount = 0;

        items.forEach(item => {
            const name = item.querySelector('.user-name').textContent.toLowerCase();
            const inputId = item.getAttribute('for');
            const input = document.getElementById(inputId);

            if (name.includes(filter)) {
                item.style.display = "flex";
                input.style.display = "block"; // Keep logic flow intact
                visibleCount++;
            } else {
                item.style.display = "none";
                input.style.display = "none";
            }
        });

        const noMsg = document.getElementById('noUsersMsg');
        if(noMsg) noMsg.style.display = visibleCount === 0 ? "block" : "none";
    });
</script>