@model Project_Managent_System.ViewModels.UserProfileViewModel
@{
    ViewBag.Title = "My Corporate Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-blue: #2563eb;
        --dark-slate: #0f172a;
    }

    .profile-card {
        border: none;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .profile-cover {
        height: 120px;
        background: linear-gradient(135deg, var(--dark-slate) 0%, var(--primary-blue) 100%);
    }

    .avatar-wrapper {
        margin-top: -65px;
        position: relative;
        display: inline-block;
    }

    .profile-img-main {
        width: 130px;
        height: 130px;
        border: 5px solid #fff;
        border-radius: 25px;
        object-fit: cover;
        background: #f8fafc;
    }

    .social-link-btn {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f1f5f9;
        color: #475569;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .social-link-btn:hover {
            background: var(--primary-blue);
            color: white;
            transform: translateY(-3px);
        }

    .form-label-custom {
        font-size: 0.75rem;
        font-weight: 800;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .pms-input {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.6rem 1rem;
        transition: border-color 0.2s;
    }

        .pms-input:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
        }

    .btn-update {
        background: var(--primary-blue);
        border: none;
        padding: 0.8rem 2.5rem;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s;
    }

        .btn-update:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
        }
</style>

<div class="container py-5 animate__animated animate__fadeIn">

    @* Notification Messages *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
            <div><strong>Success!</strong> @TempData["Message"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="profile-card text-center pb-4">
                <div class="profile-cover"></div>
                <div class="avatar-wrapper">
                    <img src="@(string.IsNullOrEmpty(Model.ProfilePicturePath) ? Url.Content("~/Content/images/default-avatar.png") : Url.Content("~" + Model.ProfilePicturePath))"
                         class="profile-img-main shadow" id="imgPreview">
                </div>

                <h4 class="fw-bold mt-3 mb-1">@Model.FirstName @Model.LastName</h4>
                <p class="text-muted small mb-3">@Model.Designation • @Model.Department</p>

                <div class="d-flex justify-content-center gap-2 mb-4">
                    @if (!string.IsNullOrEmpty(Model.GitHubUrl))
                    {
                        <a href="@Model.GitHubUrl" target="_blank" class="social-link-btn"><i class="bi bi-github"></i></a>
                    }
                    @if (!string.IsNullOrEmpty(Model.LinkedInUrl))
                    {
                        <a href="@Model.LinkedInUrl" target="_blank" class="social-link-btn"><i class="bi bi-linkedin"></i></a>
                    }
                </div>

                <div class="px-4 text-start">
                    <div class="p-3 rounded-4 bg-light">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-envelope text-primary me-3"></i>
                            <span class="small">@Model.Email</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-person-badge text-primary me-3"></i>
                            <span class="small">@Model.Role</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="profile-card p-4 p-md-5">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3">
                        <i class="bi bi-pencil-square text-primary fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Professional Settings</h5>
                </div>

                @using (Html.BeginForm("UpdateProfile", "User_Profiles", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.UserId)
                    @Html.HiddenFor(m => m.ProfilePicturePath)

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label-custom">Employee ID</label>
                            @Html.TextBoxFor(m => m.EmployeeId, new { @class = "form-control pms-input", placeholder = "e.g. EMP-101" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Current Designation</label>
                            @Html.TextBoxFor(m => m.Designation, new { @class = "form-control pms-input", placeholder = "e.g. IT Consultant" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Department</label>
                            @Html.TextBoxFor(m => m.Department, new { @class = "form-control pms-input" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Update Profile Image</label>
                            <input type="file" name="ProfileImage" class="form-control pms-input" onchange="previewImage(this)">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label-custom">GitHub Profile URL</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-github"></i></span>
                                @Html.TextBoxFor(m => m.GitHubUrl, new { @class = "form-control pms-input", placeholder = "https://github.com/..." })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">LinkedIn Profile URL</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-linkedin"></i></span>
                                @Html.TextBoxFor(m => m.LinkedInUrl, new { @class = "form-control pms-input", placeholder = "https://linkedin.com/in/..." })
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label-custom">Professional Bio</label>
                            @Html.TextAreaFor(m => m.Bio, new { @class = "form-control pms-input", rows = "4", placeholder = "Briefly describe your role and expertise..." })
                        </div>

                        <div class="col-12 text-end pt-3">
                            <hr class="opacity-5 mb-4">
                            <button type="submit" class="btn btn-primary btn-update shadow text-white">
                                <i class="bi bi-check2-circle me-2"></i> Save Profile
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Script for instant image preview *@
<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imgPreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>