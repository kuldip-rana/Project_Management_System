@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure Bootstrap 5 is linked here
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    }

    body {
        background-color: #f8fafc;
        font-family: 'Inter', sans-serif;
    }

    .stat-card {
        border: none;
        border-radius: 16px;
        transition: transform 0.2s;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .glass-panel {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.3);
    }

    .table-hover tbody tr:hover {
        background-color: #f1f5f9;
        cursor: pointer;
    }

    .badge-soft-warning {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-soft-primary {
        background: #e0e7ff;
        color: #3730a3;
    }
</style>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-dark">Welcome Back, @Session["Name"] 👋</h2>
            <p class="text-muted">Here’s what’s happening with your projects today.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card card bg-white p-3 border-start border-warning border-5">
                <div class="d-flex align-items-center">
                    <div class="p-3 badge-soft-warning rounded-circle me-3">⏳</div>
                    <div>
                        <p class="text-muted mb-0 small uppercase fw-bold">Pending Tasks</p>
                        <h3 class="mb-0 fw-bold">@ViewBag.PendingCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card card bg-white p-3 border-start border-primary border-5">
                <div class="d-flex align-items-center">
                    <div class="p-3 badge-soft-primary rounded-circle me-3">🚀</div>
                    <div>
                        <p class="text-muted mb-0 small uppercase fw-bold">In Progress</p>
                        <h3 class="mb-0 fw-bold">@ViewBag.InProgressCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card card bg-white p-3 border-start border-success border-5">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-light rounded-circle me-3">✅</div>
                    <div>
                        <p class="text-muted mb-0 small uppercase fw-bold">Completed</p>
                        <h3 class="mb-0 fw-bold">@ViewBag.CompletedCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-5 mb-4">
            <div class="card glass-panel shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">Task Distribution</h5>

                    <canvas id="statusChart" height="250"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-7 mb-4">
            <div class="card glass-panel shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold">Upcoming Deadlines</h5>
                        <a href="#" class="btn btn-sm btn-outline-primary rounded-pill">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Task Name</th>
                                    <th>Deadline</th>
                                    <th>Priority</th>
                                    @*<th>Action</th>*@
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@task.TaskTitle</td>
                                        <td>
                                            <span class="text-muted">📅 @task.DueDate.ToString("dd MMM yyyy")</span>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill @(task.Priority == "High" ? "bg-danger" : "bg-info")">@task.Priority</span>
                                        </td>
                                        @*<td>
                                            <button class="btn btn-light btn-sm rounded-circle shadow-sm">⚙️</button>
                                        </td>*@
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const ctx = document.getElementById('statusChart').getContext('2d');
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Pending', 'In Progress', 'Completed'],
            datasets: [{
                data: [@ViewBag.PendingCount, @ViewBag.InProgressCount, @ViewBag.CompletedCount],
                backgroundColor: ['#fbbf24', '#6366f1', '#22c55e'],
                hoverOffset: 4,
                borderWidth: 0
            }]
        },
        options: {
            plugins: { legend: { position: 'bottom' } },
            cutout: '70%'
        }
    });
</script>