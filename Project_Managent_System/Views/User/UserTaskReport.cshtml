@model IEnumerable<Project_Managent_System.Models.Task_Assignments>

@{
    ViewBag.Title = "My Progress Report";
}

<div class="container-fluid py-4 px-4">
    <div class="mb-4">
        <h2 class="fw-bold text-slate-900">Performance Report</h2>
        <p class="text-muted">Detailed breakdown of your project contributions and task velocity.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="text-muted small fw-bold text-uppercase">Total Assignments</div>
                <div class="h2 fw-bold mb-0">@ViewBag.TotalTasks</div>
                <div class="progress mt-3" style="height: 6px;">
                    <div class="progress-bar bg-indigo" style="width: 100%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="text-muted small fw-bold text-uppercase">Completed</div>
                <div class="h2 fw-bold text-success mb-0">@ViewBag.CompletedTasks</div>
                <div class="progress mt-3" style="height: 6px;">
                    <div class="progress-bar bg-success" style="width: @ViewBag.CompletionRate%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="text-muted small fw-bold text-uppercase">Pending</div>
                <div class="h2 fw-bold text-warning mb-0">@ViewBag.PendingTasks</div>
                <div class="progress mt-3" style="height: 6px;">
                    @* To this (safer): *@
                    @{
                        int completionRate = ViewBag.CompletionRate ?? 0;
                        int pendingRate = 100 - completionRate;
                    }
                    <div class="progress-bar bg-warning" style="width: @pendingRate%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-indigo text-white">
                <div class="small fw-bold text-uppercase opacity-75">Efficiency Rate</div>
                <div class="h2 fw-bold mb-0">@ViewBag.CompletionRate%</div>
                <div class="small mt-3">Tasks completed vs assigned</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold">Task Breakdown</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Project</th>
                        <th>Task Name</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th class="pe-4">Deadline</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="fw-medium text-slate-700">@item.Task.Project.ProjectName</span>
                            </td>
                            <td>
                                <div class="fw-bold">@item.Task.TaskTitle</div>
                                <div class="text-muted small">ID: #T-@item.TaskId</div>
                            </td>
                            <td>
                                <span class="badge @(item.Task.Priority == "High" ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") rounded-pill">
                                    @item.Task.Priority
                                </span>
                            </td>
                            <td>
                                @if (item.TaskStatus == "Completed")
                                {
                                    <span class="text-success small fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Completed</span>
                                }
                                else
                                {
                                    <span class="text-warning small fw-bold"><i class="bi bi-clock-history me-1"></i>In Progress</span>
                                }
                            </td>
                            <td class="pe-4 text-muted">@item.Task.DueDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-indigo {
        background-color: #4F46E5 !important;
    }

    .text-indigo {
        color: #4F46E5 !important;
    }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .progress-bar {
        border-radius: 10px;
    }
</style>