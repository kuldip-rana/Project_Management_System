@model Project_Managent_System.Models.Task_Assignments

@{
    ViewBag.Title = "Task Details";
}

<div class="container py-5">
    <div class="mb-4">
        <a href="@Url.Action("UserDashboard", "User")" class="text-decoration-none text-indigo fw-medium">
            <i class="bi bi-arrow-left me-1"></i> Back to Console
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="badge bg-indigo-soft text-indigo mb-2">#T-@Model.TaskId</span>
                        <h1 class="fw-bold text-slate-900">@Model.Task.TaskTitle</h1>
                    </div>
                    <span class="badge @(Model.Task.Priority == "High" ? "bg-danger" : "bg-primary") rounded-pill px-3 py-2">
                        @Model.Task.Priority Priority
                    </span>
                </div>

                <hr class="text-slate-200">

                <div class="task-description py-3">
                    <h5 class="fw-bold text-slate-800 mb-3">Description</h5>
                    <p class="text-slate-600 lh-lg">
                        @Model.Task.TaskDescription
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="m-0 fw-bold text-slate-900">Discussion & Activity</h5>
                </div>
                <div class="bg-slate-50" id="commentsContainer" style="min-height: 300px;">
                    @Html.Action("GetTaskComments", new { id = Model.TaskId })
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 2rem;">
                <h5 class="fw-bold text-slate-900 mb-4">Project Overview</h5>

                <div class="mb-4">
                    <label class="text-muted small text-uppercase fw-bold">Project Name</label>
                    <p class="text-slate-800 fw-medium m-0">@Model.Task.Project.ProjectName</p>
                </div>

                <div class="mb-4">
                    <label class="text-muted small text-uppercase fw-bold">Current Status</label>
                    <div class="mt-2">
                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                            <i class="bi bi-circle-fill me-1 small"></i> @Model.TaskStatus
                        </span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-bold">Start Date</label>
                        <p class="text-slate-800 m-0">@Model.Task.StartDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-bold">Due Date</label>
                        <p class="@(Model.Task.DueDate < DateTime.Now ? "text-danger fw-bold" : "text-slate-800") m-0">
                            @Model.Task.DueDate.ToString("MMM dd, yyyy")
                        </p>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <label class="text-muted small text-uppercase fw-bold mt-2">Update Progress</label>
                    <select id="statusDropdown" class="form-select border-0 bg-slate-50 rounded-3 mb-2">
                        <option value="Pending" @(Model.TaskStatus == "Pending" ? "selected" : "")>Pending</option>
                        <option value="In Progress" @(Model.TaskStatus == "In Progress" ? "selected" : "")>In Progress</option>
                        <option value="Completed" @(Model.TaskStatus == "Completed" ? "selected" : "")>Completed</option>
                    </select>

                    <button class="btn btn-indigo py-2 rounded-3" onclick="syncStatusAndComment(@Model.TaskId, @Model.Id)">
                        <i class="bi bi-send-check me-2"></i> Update & Notify
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8fafc;
    }

    .bg-indigo-soft {
        background: #eef2ff;
        color: #4F46E5;
    }

    .text-indigo {
        color: #4F46E5;
    }

    .btn-indigo {
        background: #4F46E5;
        color: white;
        border: none;
    }

        .btn-indigo:hover {
            background: #4338ca;
            color: white;
        }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .text-slate-600 {
        color: #475569;
    }

    .text-slate-800 {
        color: #1e293b;
    }

    .text-slate-900 {
        color: #0f172a;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function syncStatusAndComment(taskId, assignmentId) {
        const newStatus = $('#statusDropdown').val();

        // 1. Update the Status
        $.ajax({
            url: '@Url.Action("UpdateTaskStatus", "User")',
            type: 'POST',
            data: {
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                assignmentId: assignmentId,
                newStatus: newStatus
            },
            success: function(response) {
                // 2. Load/Refresh the chat area so user can add a reason/comment
                loadComments(taskId);

                // Optional: Scroll to chat
                document.getElementById('commentsContainer').scrollIntoView({ behavior: 'smooth' });
            }
        });
    }

    function loadComments(taskId) {
        const container = $('#commentsContainer');
        container.html('<div class="text-center py-5"><div class="spinner-border text-indigo"></div></div>');

        $.ajax({
            url: '@Url.Action("GetTaskComments", "User")',
            type: 'GET',
            data: { id: taskId },
            success: function (data) {
                container.html(data);
                bindPartialViewForm(); // Re-bind the Post button in the loaded partial
            }
        });
    }

    // Helper to handle the "Send" button inside the comment thread
    function bindPartialViewForm() {
        $('#commentForm').off('submit').on('submit', function (e) {
            e.preventDefault();
            const form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (res) {
                    if (res.success) loadComments(@Model.TaskId);
                }
            });
        });
    }
</script>