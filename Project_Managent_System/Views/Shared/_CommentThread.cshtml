@model IEnumerable<Project_Managent_System.ViewModels.CommentItem>

<div class="chat-wrapper d-flex flex-column h-100" style="background-color: #efeae2;">
    <div id="chatMessages" class="chat-messages flex-grow-1 p-3" style="overflow-y: auto; max-height: 70vh;">
        @if (!Model.Any())
        {
            <div class="text-center mt-5">
                <span class="badge bg-white text-muted shadow-sm px-3 py-2 rounded-pill">
                    No comments yet. Start the conversation!
                </span>
            </div>
        }
        else
        {
            DateTime? lastDate = null;
            foreach (var item in Model)
            {
                if (lastDate?.Date != item.CreatedAt.Date)
                {
                    <div class="text-center my-3">
                        <span class="badge shadow-sm px-3" style="background-color: #d1d7db; color: #54656f; border-radius: 7px;">
                            @(item.CreatedAt.Date == DateTime.Today ? "TODAY" : item.CreatedAt.ToString("MMM dd, yyyy").ToUpper())
                        </span>
                    </div>
                    lastDate = item.CreatedAt;
                }

                // Check if the message is from the logged-in user
                var isMe = item.UserId == Convert.ToInt32(Session["UserId"]);

                <div class="mb-2 d-flex @(isMe ? "justify-content-end" : "justify-content-start")">
                    <div class="p-2 px-3 shadow-sm"
                         style="max-width: 80%;
                                border-radius: @(isMe ? "10px 10px 0 10px" : "10px 10px 10px 0");
                                background-color: @(isMe ? "#dcf8c6" : "#ffffff");
                                color: #303030;">

                        @if (!isMe)
                        {
                            <div class="fw-bold small mb-1" style="color: #075e54; font-size: 0.75rem;">@item.UserName (@item.Role)</div>
                        }

                        <div class="message-text" style="font-size: 0.95rem; line-height: 1.4;">@item.Message</div>

                        <div class="d-flex align-items-center justify-content-end gap-1 mt-1 opacity-75" style="font-size: 0.65rem;">
                            @item.CreatedAt.ToString("hh:mm tt")
                            @if (isMe)
                            {
                                <i class="bi bi-check2-all text-primary ms-1"></i>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @* The input form is now visible to everyone *@
    <div class="p-3 border-top bg-white">
        @using (Html.BeginForm("PostComment", "Chat", FormMethod.Post, new { id = "commentForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="TargetId" value="@ViewBag.TargetId" />
            <input type="hidden" name="ChatType" value="@ViewBag.ChatType" />
            <div class="input-group bg-light rounded-pill p-1">
                <input type="text" name="Message" id="chatInput" class="form-control border-0 bg-transparent ps-3" placeholder="Type a message..." required autocomplete="off" />
                <button type="submit" class="btn btn-primary rounded-circle p-2 ms-2" style="width: 40px; height: 40px;">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        }
    </div>
</div>