<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TaskZIP</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #6366F1;
            --sidebar-bg: #1E1B4B;
            --sidebar-width: 260px;
            --top-header-height: 70px;
            --bg-body: #F3F4F6;
            --accent: #F43F5E;
        }

        body {
            background-color: var(--bg-body);
            font-family: 'Inter', sans-serif;
            margin: 0;
        }

        /* --- SIDEBAR --- */
        #sidebar {
            width: var(--sidebar-width);
            background-color: var(--sidebar-bg);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 1040;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }

            #sidebar.collapsed {
                margin-left: calc(-1 * var(--sidebar-width));
            }

        .sidebar-header {
            padding: 25px 20px;
            display: flex;
            align-items: center;
            color: white;
        }

        /* --- NAV LINKS --- */
        .nav-list {
            padding: 10px;
            list-style: none;
            flex: 1;
            overflow-y: auto;
        }

        .nav-link {
            color: #94a3b8;
            padding: 12px 15px;
            margin-bottom: 5px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: all 0.2s;
        }

            .nav-link i {
                font-size: 1.2rem;
                margin-right: 12px;
            }

            .nav-link:hover {
                background: rgba(255,255,255,0.1);
                color: #fff;
            }

            .nav-link.active {
                background: var(--primary);
                color: #fff;
                box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
            }

        .logout-link {
            color: var(--accent) !important;
            font-weight: 600;
            margin-top: auto;
        }

        /* --- TOP HEADER --- */
        .top-header {
            height: var(--top-header-height);
            background: #fff;
            position: fixed;
            top: 0;
            right: 0;
            left: var(--sidebar-width);
            z-index: 1030;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            border-bottom: 1px solid #e5e7eb;
            transition: all 0.3s ease;
        }

        #sidebar.collapsed + .top-header {
            left: 0;
        }

        /* --- CONTENT AREA --- */
        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: var(--top-header-height);
            padding: 30px;
            transition: all 0.3s ease;
        }

        #sidebar.collapsed ~ .main-content {
            margin-left: 0;
        }

        /* Profile Dropdown */
        .profile-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            padding: 5px 10px;
            border-radius: 50px;
        }

            .profile-pill:hover {
                background: #f1f5f9;
            }

        .avatar-circle {
            width: 35px;
            height: 35px;
            background: var(--primary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        /* --- COMMENT DRAWER (RESTORED) --- */
        #commentDrawer {
            position: fixed;
            top: 0;
            right: -450px;
            width: 450px;
            height: 100vh;
            background: white;
            box-shadow: -5px 0 25px rgba(0,0,0,0.1);
            transition: right 0.3s ease;
            z-index: 2000;
            display: flex;
            flex-direction: column;
        }

            #commentDrawer.open {
                right: 0;
            }

        .drawer-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.3);
            display: none;
            z-index: 1999;
            backdrop-filter: blur(2px);
        }

            .drawer-overlay.active {
                display: block;
            }
    </style>
</head>
<body>

    @if (Session["UserId"] == null)
    {
        @* --- GUEST VIEW (Same as original) --- *@
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
            <div class="container">
                @Html.ActionLink("TaskZIP", "Index", "Home", null, new { @class = "navbar-brand fw-bold" })
                <div class="collapse navbar-collapse" id="guestNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">@Html.ActionLink("Login", "Login", "Signup_Login", null, new { @class = "btn btn-outline-light rounded-pill px-4" })</li>
                    </ul>
                </div>
            </div>
        </nav>
        <div style="margin-top: 100px;">@RenderBody()</div>
    }
    else
    {
        <nav id="sidebar">
            <div class="sidebar-header">
                <i class="bi bi-rocket-takeoff-fill fs-3 me-2 text-primary"></i>
                <span class="fs-4 fw-bold">TaskZIP</span>
            </div>

            <ul class="nav-list">
                @{
                    // Capture current URL details to handle active state
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                }

                @if (Session["Role"]?.ToString() == "Manager")
                {
                    <li><a href="@Url.Action("ManagerDashboard", "Manager")" class="nav-link @(currentAction == "ManagerDashboard" ? "active" : "")"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Calendar", "Calender")" class="nav-link @(currentController == "Calender" ? "active" : "")"><i class="bi bi-calendar3"></i> Timeline Calendar</a></li>
                    <li><a href="@Url.Action("CreateProject", "Manager")" class="nav-link @(currentAction == "CreateProject" ? "active" : "")"><i class="bi bi-folder-plus"></i> Create Project</a></li>
                    <li><a href="@Url.Action("CreateTask", "Tasks")" class="nav-link @(currentAction == "CreateTask" ? "active" : "")"><i class="bi bi-pencil-square"></i> Create Task</a></li>
                    <li><a href="@Url.Action("AssignTask", "Tasks")" class="nav-link @(currentAction == "AssignTask" ? "active" : "")"><i class="bi bi-person-plus"></i> Assign Task</a></li>
                    <li><a href="@Url.Action("ReAssignTask", "Tasks")" class="nav-link @(currentAction == "ReAssignTask" ? "active" : "")"><i class="bi bi-arrow-repeat"></i> Reassign Task</a></li>
                    <li><a href="@Url.Action("DisplayProjects", "Manager")" class="nav-link @(currentAction == "DisplayProjects" ? "active" : "")"><i class="bi bi-folder2-open"></i> View Projects</a></li>
                    <li><a href="@Url.Action("DisplayTaskList", "Tasks")" class="nav-link @(currentAction == "DisplayTaskList" ? "active" : "")"><i class="bi bi-card-checklist"></i> View Tasks</a></li>
                }
                else if (Session["Role"]?.ToString() == "Admin")
                {
                    <li><a href="@Url.Action("AdminDashboard", "Admin")" class="nav-link @(currentAction == "AdminDashboard" ? "active" : "")"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Calendar", "Calender")" class="nav-link @(currentController == "Calender" ? "active" : "")"><i class="bi bi-calendar3"></i> Global Calendar</a></li>
                    <li><a href="@Url.Action("ManageUsers", "Admin")" class="nav-link @(currentAction == "ManageUsers" ? "active" : "")"><i class="bi bi-person-plus"></i> Manage Users</a></li>
                    <li><a href="@Url.Action("ManageProjects", "Admin")" class="nav-link @(currentAction == "ManageProjects" ? "active" : "")"><i class="bi bi-folder-plus"></i> Manage Projects</a></li>
                    <li><a href="@Url.Action("ManageTasks", "Admin")" class="nav-link @(currentAction == "ManageTasks" ? "active" : "")"><i class="bi bi-pencil-square"></i> Manage Tasks</a></li>
                }
                else if (Session["Role"]?.ToString() == "User")
                {
                    <li><a href="@Url.Action("UserDashboard", "User")" class="nav-link @(currentAction == "UserDashboard" ? "active" : "")"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Calendar", "Calender")" class="nav-link @(currentController == "Calender" ? "active" : "")"><i class="bi bi-calendar-event"></i> My Schedule</a></li>
                    <li><a href="@Url.Action("MyTasks", "User")" class="nav-link @(currentAction == "MyTasks" ? "active" : "")"><i class="bi bi-folder-plus"></i> My Assignments</a></li>
                    <li><a href="@Url.Action("UserTaskReport", "User")" class="nav-link @(currentAction == "UserTaskReport" ? "active" : "")"><i class="bi bi-person-plus"></i> Task Report</a></li>
                    <li><a href="@Url.Action("MyProjects", "User")" class="nav-link @(currentAction == "MyProjects" ? "active" : "")"><i class="bi bi-pencil-square"></i> My Projects</a></li>
                }

                @*<li class="mt-auto pt-4 border-top border-secondary-subtle">
            <a href="@Url.Action("Logout", "Signup_Login")" class="nav-link logout-link text-danger">
                <i class="bi bi-box-arrow-right"></i> Logout
            </a>
        </li>*@
            </ul>
        </nav>

        <header class="top-header">
            <div class="d-flex align-items-center gap-3">
                <button id="sidebarToggle" class="btn btn-white border-0 fs-4"><i class="bi bi-list"></i></button>
                <h5 class="mb-0 fw-semibold text-muted d-none d-md-block">Welcome back, @Session["FirstName"]</h5>
            </div>

            <div class="d-flex align-items-center gap-4">
                <i class="bi bi-bell fs-5 text-muted"></i>
                <div class="dropdown">
                    <div class="profile-pill dropdown-toggle" data-bs-toggle="dropdown">
                        <div class="avatar-circle">U</div>
                        <span class="fw-bold small">My Profile</span>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i> Profile</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger fw-bold" href="@Url.Action("Logout", "Signup_Login")">Logout</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="main-content">
            <div class="container-fluid">@RenderBody()</div>
        </main>

        <div class="drawer-overlay" id="drawerOverlay"></div>
        <div id="commentDrawer">
            <div class="p-3 bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Discussion</h5>
                <button type="button" class="btn-close btn-close-white" onclick="closeComments()"></button>
            </div>
            <div id="drawerBody" class="flex-grow-1 overflow-auto bg-light"></div>
        </div>
    }

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://www.gstatic.com/charts/loader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>

    <script>
        $(document).ready(function () {
            // Toggle Sidebar
            $('#sidebarToggle').on('click', function () {
                $('#sidebar').toggleClass('collapsed');
            });

            // Restore SignalR logic here...
            // [Existing SignalR code from your previous file goes here]
        });

        function closeComments() {
            $('#commentDrawer').removeClass('open');
            $('#drawerOverlay').removeClass('active');
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>