@{
    ViewBag.Title = "Contact Us";
}

<style>
    .contact-info-card {
        background: var(--primary);
        color: white;
        border-radius: 1rem;
        padding: 2.5rem;
        height: 100%;
    }

    .contact-form-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        padding: 2.5rem;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #4b5563;
    }
</style>

<div class="container py-5 mt-5">
    <div class="row g-5">
        <div class="col-lg-5">
            <div class="contact-info-card shadow-lg">
                <h2 class="fw-bold mb-4">Let's talk.</h2>
                <p class="mb-5 opacity-75">Have questions about our project management tools? Our team is here to help you scale.</p>

                <div class="d-flex align-items-center mb-4">
                    <i class="bi bi-geo-alt-fill me-3 fs-4"></i>
                    <div>
                        <div class="fw-bold">Office</div>
                        <div class="small opacity-75">123 Tech Elecon Pvt Ltd, Anand - Sojitra Road, Anand</div>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <i class="bi bi-envelope-paper-fill me-3 fs-4"></i>
                    <div>
                        <div class="fw-bold">Email Us</div>
                        <div class="small opacity-75">support@taskzip.com</div>
                    </div>
                </div>

                <div class="mt-5 pt-5">
                    <p class="small text-uppercase tracking-wider opacity-50 mb-3">Follow Us</p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-white"><i class="bi bi-linkedin fs-5"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-twitter-x fs-5"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-github fs-5"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card contact-form-card">
                <h4 class="fw-bold mb-4 text-dark">Send a Message</h4>
                <form action="#" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">FULL NAME</label>
                            <input type="text" class="form-control bg-light border-0 py-3" placeholder="John Doe">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">EMAIL ADDRESS</label>
                            <input type="email" class="form-control bg-light border-0 py-3" placeholder="john@example.com">
                        </div>
                        <div class="col-12 mt-4">
                            <label class="form-label">MESSAGE</label>
                            <textarea class="form-control bg-light border-0 py-3" rows="5" placeholder="How can we help?"></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-brand rounded-pill px-5 py-3 shadow-sm">
                                Send Message <i class="bi bi-send-fill ms-2"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>